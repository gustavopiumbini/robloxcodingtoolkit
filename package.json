{
  "name": "rbxkit",
  "version": "0.1.0",
  "description": "Roblox vibe coding toolkit: agent skills, a Rojo game template, 3D build tools and a CLI for Claude Code and Codex with Roblox Studio",
  "type": "module",
  "bin": {
    "rbxkit": "tools/rbxkit.mjs"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "agent",
    "skills",
    "template",
    "tools"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:template": "node tools/rbxkit.mjs check --strict template/src"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "roblox",
    "luau",
    "rojo",
    "claude-code",
    "codex",
    "agent-skills",
    "mcp"
  ],
  "license": "MIT"
}
